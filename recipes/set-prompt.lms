# Set a short Bash prompt using the existing SSH alias/configuration.
# Preview: lmctl recipes/set-prompt.lms web1 web1 [EXPECTED_HOSTNAME]
# Apply:   lmctl recipes/set-prompt.lms web1 web1 [EXPECTED_HOSTNAME] --apply
import "../scripts/lib/args.lms";
import "../scripts/lib/prompt.lms";
let options=parse_prompt_args(ARGV);
set_host_prompt(options.destination,options.label,options.expected_hostname,options.apply);
