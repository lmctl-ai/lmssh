# Reusable lmssh recipe: set an interactive Bash prompt on one SSH destination.
# Existing SSH config/ProxyJump/known-host aliases apply. No key or sshd changes.
# expected_hostname may be empty for a generic host; fleet scripts should supply it.
let prompt_python=join([
  "import datetime",
  "import json",
  "import os",
  "from pathlib import Path",
  "import re",
  "import socket",
  "import stat",
  "import subprocess",
  "import sys",
  "import tempfile",
  "import uuid",
  "",
  "BEGIN = \"# >>> lmssh host prompt >>>\"",
  "END = \"# <<< lmssh host prompt <<<\"",
  "",
  "def verify_prompt(home, expected):",
  "    command = 'printf \"\\\\036%s\\\\037\" \"$PS1\"; printf \"\\\\036%s\\\\037\" \"${PS1@P}\"'",
  "    probe = subprocess.run([\"bash\", \"--noprofile\", \"-ic\", command],",
  "                           cwd=home / \"repos\" if (home / \"repos\").is_dir() else home,",
  "                           capture_output=True, timeout=30)",
  "    parts = re.findall(rb\"\\x1e([^\\x1f]*)\\x1f\", probe.stdout)",
  "    if probe.returncode or len(parts) != 2 or parts[0].decode() != expected:",
  "        raise RuntimeError(\"interactive Bash prompt verification failed\")",
  "    return parts[1].decode()",
  "",
  "def main():",
  "    options = json.loads(sys.argv[1])",
  "    label = options[\"label\"]",
  "    expected_hostname = options[\"expected_hostname\"]",
  "    apply = options[\"apply\"]",
  "    if not isinstance(apply, bool) or not re.fullmatch(r\"[a-z][a-z0-9-]{0,31}\", label):",
  "        raise ValueError(\"invalid prompt label or apply flag\")",
  "    actual_hostname = socket.gethostname()",
  "    if expected_hostname and actual_hostname != expected_hostname:",
  "        raise RuntimeError(\"SSH destination hostname does not match the expected host\")",
  "    home = Path.home()",
  "    rc = (home / \".bashrc\").resolve()",
  "    if not rc.is_file() or rc.stat().st_uid != os.geteuid():",
  "        raise RuntimeError(\"expected an existing user-owned .bashrc\")",
  "    check_mode = rc.stat().st_mode",
  "    original = rc.read_bytes()",
  "    text = original.decode(\"utf-8\")",
  "    if text.count(BEGIN) != text.count(END) or text.count(BEGIN) > 1:",
  "        raise RuntimeError(\"ambiguous or incomplete managed prompt block\")",
  "    pattern = re.compile(re.escape(BEGIN) + r\"\\n.*?\\n\" + re.escape(END) + r\"(?:\\n|$)\", re.S)",
  "    expected = label + r\":\\w\\$ \"",
  "    block = BEGIN + \"\\n# Managed by lmssh; affects interactive Bash only.\\ncase $- in\\n  *i*) PS1='\" + expected + \"' ;;\\nesac\\n\" + END + \"\\n\"",
  "    if BEGIN in text:",
  "        match = pattern.search(text)",
  "        if match is None:",
  "            raise RuntimeError(\"malformed managed prompt block\")",
  "        # Keep the managed block at the end, so existing PS1 definitions do not override it.",
  "        prefix = text[:match.start()] + text[match.end():]",
  "        candidate = prefix.rstrip(\"\\n\") + \"\\n\\n\" + block",
  "    else:",
  "        candidate = text.rstrip(\"\\n\") + \"\\n\\n\" + block",
  "    encoded = candidate.encode(\"utf-8\")",
  "    check = subprocess.run([\"bash\", \"-n\"], input=encoded, capture_output=True, timeout=10)",
  "    if check.returncode:",
  "        raise RuntimeError(\"candidate .bashrc did not pass bash -n\")",
  "    changed = encoded != original",
  "    result = {\"label\": label, \"hostname\": actual_hostname, \"status\": \"preview\" if not apply else \"unchanged\",",
  "              \"desired_ps1\": expected, \"changed\": changed}",
  "    if not apply:",
  "        print(json.dumps(result))",
  "        return",
  "    backup = None",
  "    if changed:",
  "        stamp = datetime.datetime.now(datetime.timezone.utc).strftime(\"%Y%m%dT%H%M%SZ\")",
  "        backup_dir = home / \".local/state/lmssh/prompt-backups\"",
  "        backup_dir.mkdir(parents=True, exist_ok=True, mode=0o700)",
  "        os.chmod(backup_dir, 0o700)",
  "        backup = backup_dir / (\"bashrc-\" + stamp + \"-\" + uuid.uuid4().hex[:8])",
  "        with os.fdopen(os.open(backup, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), \"wb\") as out:",
  "            out.write(original)",
  "            out.flush()",
  "            os.fsync(out.fileno())",
  "        descriptor, staged = tempfile.mkstemp(prefix=\".lmssh-prompt-\", dir=rc.parent)",
  "        try:",
  "            with os.fdopen(descriptor, \"wb\") as out:",
  "                out.write(encoded)",
  "                out.flush()",
  "                os.fsync(out.fileno())",
  "                os.fchmod(out.fileno(), stat.S_IMODE(rc.stat().st_mode))",
  "            if rc.read_bytes() != original:",
  "                raise RuntimeError(\".bashrc changed concurrently; refusing to overwrite it\")",
  "            os.replace(staged, rc)",
  "        finally:",
  "            if os.path.exists(staged):",
  "                os.unlink(staged)",
  "        result[\"status\"] = \"updated\"",
  "        result[\"backup\"] = str(backup)",
  "    try:",
  "        result[\"rendered_prompt\"] = verify_prompt(home, expected)",
  "    except Exception:",
  "        # Roll back only our exact candidate; preserve any concurrent user edits.",
  "        if changed and rc.read_bytes() == encoded:",
  "            descriptor, restore = tempfile.mkstemp(prefix=\".lmssh-prompt-restore-\", dir=rc.parent)",
  "            try:",
  "                with os.fdopen(descriptor, \"wb\") as out:",
  "                    out.write(original)",
  "                    out.flush()",
  "                    os.fsync(out.fileno())",
  "                    os.fchmod(out.fileno(), stat.S_IMODE(check_mode))",
  "                os.replace(restore, rc)",
  "            finally:",
  "                if os.path.exists(restore):",
  "                    os.unlink(restore)",
  "        raise",
  "    print(json.dumps(result))",
  "",
  "try:",
  "    main()",
  "except Exception as error:",
  "    print(json.dumps({\"error\": type(error).__name__, \"message\": str(error)}), file=sys.stderr)",
  "    sys.exit(1)"
],"\n");
fn prompt_shell_quote(value){return "'"+replace_all(value,"'","'\\''")+"'";}
fn set_host_prompt(destination,label,expected_hostname,apply){
  assert(regex_test(label,"^[a-z][a-z0-9-]{0,31}$"),"prompt label must be a short lowercase host alias");
  assert(destination!=""&&!starts_with(destination,"-")&&!contains(destination,"\n")&&!contains(destination,"\r"),"invalid SSH destination");
  let options=json_stringify({label:label,expected_hostname:expected_hostname,apply:apply});
  let command="python3 - "+prompt_shell_quote(options);
  let program=_dsl_ cli="lmssh" install="github:lmctl-ai/lmssh@latest";
let session=ssh.connect(${destination}).strict_host_key("yes").connect_timeout(12).timeout(60);
let result=session.exec(${command},${prompt_python});
io.print(result.stdout());
if(!result.ok()){io.eprint(result.stderr());io.fail("prompt configuration failed on "+${destination});}
end _dsl_
  let code=temp_file();savedsl(program,code);
  let result=system(concat(dsl_cli(program),["--dsl",code]),{timeoutMs:75000});
  remove_file(code);
  println(result.stdout);
  if(result.code!=0){println(result.stderr);}
  assert(result.code==0,"prompt update failed for "+destination);
}
