# rotate-key
# usage: lmssh --dsl rotate-key.dslb -- DEST OLD_PRIVATE_KEY NEW_PRIVATE_KEY [AUTHORIZED_KEYS_PATH]
# AUTHORIZED_KEYS_PATH is on the remote side and defaults to ~/.ssh/authorized_keys.
# Creates NEW_PRIVATE_KEY, installs its public half, proves the new key logs in, then removes the old key from authorized_keys.
out = ARGV.len() > 0 ? ARGV[0] : "build/rotate-key.dslb";
p = _lmcode_ schema="../schema/lmssh.dsl.json";
# Optional: LMSSH_SSH_CONFIG points at an ssh_config(5) file; otherwise ~/.ssh/config applies as usual.
if (io.env("LMSSH_SSH_CONFIG") != "") { ssh.config(io.env("LMSSH_SSH_CONFIG")); }
let args = io.args();
if (args.len() < 3 || args.len() > 4) { io.fail("usage: lmssh --dsl rotate-key.dslb -- DEST OLD_PRIVATE_KEY NEW_PRIVATE_KEY [AUTHORIZED_KEYS_PATH]"); }
let ak = "~/.ssh/authorized_keys";
if (args.len() == 4) { ak = "'" + args.at(3) + "'"; }
let old_key = keys.load(args.at(1));
let old_pub = old_key.public();
let old_fp = old_key.fingerprint();
let new_key = keys.generate(args.at(2), "ed25519", "rotated-" + str(io.now()), "");
let via_old = ssh.connect(args.at(0)).identity(args.at(1)).connect_timeout(10);
via_old.exec("umask 077; cat >> " + ak, new_key.public() + "\n").require();
let via_new = ssh.connect(args.at(0)).identity(args.at(2)).connect_timeout(10);
if (str_trim(via_new.output("echo login-ok")) != "login-ok") { io.fail("the new key does not log in; the old key was kept"); }
# drop the old key (matched by its key material, the second field) only after the new one works
let material = str_split(old_pub, " ").at(1);
via_new.exec("grep -vF -- \"$(cat)\" " + ak + " > " + ak + ".new && mv " + ak + ".new " + ak, material + "\n").require();
io.print("rotated " + old_fp + " -> " + new_key.fingerprint());
end _lmcode_
savedsl(p, out);
