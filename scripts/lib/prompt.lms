# Caller-side wrapper for the compile-only prompt program.
# Generate tests/fixtures/lmcode/prompt.dslb with scripts/compile-lmcode-fixture.mjs first.
fn set_host_prompt(destination,label,expected_hostname,apply){
  let args=["lmssh","--lmcode","tests/fixtures/lmcode/prompt.dslb","--",destination,label,expected_hostname,apply?"true":"false"];
  let result=system(args);
  println(result.stdout);
  if(result.stderr!=""){println(result.stderr);}
  assert(result.code==0,"prompt update failed for "+destination);
}
