# fetch-files
# usage: lmssh --lmcode fetch-files.dslb -- HOSTS_FILE REMOTE_PATH OUT_DIR
# Copies REMOTE_PATH from each host into OUT_DIR/<host>/ ; hosts that fail are reported, the rest still run.
out = ARGV.len() > 0 ? ARGV[0] : "build/fetch-files.dslb";
p = _lmcode_ schema="../schema/lmssh.dsl.json";
# Optional: LMSSH_SSH_CONFIG points at an ssh_config(5) file; otherwise ~/.ssh/config applies as usual.
if (io.env("LMSSH_SSH_CONFIG") != "") { ssh.config(io.env("LMSSH_SSH_CONFIG")); }
let args = io.args();
if (args.len() != 3) { io.fail("usage: lmssh --lmcode fetch-files.dslb -- HOSTS_FILE REMOTE_PATH OUT_DIR"); }
let hosts = io.lines(args.at(0));
ssh.connect_timeout(10).timeout(300);
for (i in range(0, hosts.len())) {
  let host = str_trim(hosts.at(i));
  if (host == "" || str_starts_with(host, "#")) { continue; }
  let dir = args.at(2) + "/" + host;
  io.mkdir(dir);
  let s = ssh.connect(host);
  if (!s.ok("test -r '" + args.at(1) + "'")) {
    report.add("missing", host, 0, args.at(1) + " is not readable");
    continue;
  }
  s.get(args.at(1), dir + "/");
  io.print("fetched " + host + ":" + args.at(1) + " -> " + dir);
}
report.fail_if_any();
end _lmcode_
savedsl(p, out);
