# issue-cert
# usage: lmssh --lmcode issue-cert.dslb -- OUT_DIR       (no network)
# Compile-only lmcode source; use scripts/compile-lmcode-fixture.mjs for a private bytecode artifact.
# Creates a CA key and a user key, then issues a 4-week user certificate for principal "deploy".
p = _lmcode_ schema="../schema/lmssh.host.json";
let args = io.args();
if (args.len() != 1) { io.fail("usage: lmssh --lmcode issue-cert.dslb -- OUT_DIR"); }
io.mkdir(args.at(0));
let ca = keys.generate(args.at(0) + "/ca", "ed25519", "example-ca", "");
let user = keys.generate(args.at(0) + "/user", "ed25519", "alice", "");
let cert = keys.certify(ca.path(), args.at(0) + "/user.pub", "alice-laptop", "deploy,alice", "+4w");
io.print("CA fingerprint:   " + ca.fingerprint());
io.print("user fingerprint: " + user.fingerprint());
io.print("certificate:      " + cert);
io.print("sshd_config line: TrustedUserCAKeys <path to>/ca.pub");
end _lmcode_
